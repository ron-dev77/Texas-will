# =============================================================================
# Copy to .env.local and fill in real values.
#   cp .env.example .env.local
# Never commit .env.local (secrets / real keys).
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Vite / browser (local + Vercel)
#    Safe to expose — used by the React app.
#    Supabase → Project Settings → API
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Stripe — publishable key only in the browser (Dashboard → Developers → API keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional — only for scripts/bootstrap-admin.mjs (creates Auth user once locally).
# Admin /auth login never signs up users; use an existing verified admin in the DB.
ADMIN_EMAIL=scott@myaiwill.com
ADMIN_PASSWORD=change-me-strong-password

# -----------------------------------------------------------------------------
# 2) Supabase Edge Function secrets (NOT for Vite — do not prefix with VITE_)
#    Set on the Supabase project so checkout + questionnaire emails work.
#
#    CLI:
#      supabase secrets set STRIPE_SECRET_KEY=sk_test_xxxx
#      supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_xxxx
#      supabase secrets set STRIPE_PRICE_INDIVIDUAL=price_xxxx
#      supabase secrets set STRIPE_PRICE_COUPLES=price_xxxx
#      supabase secrets set STRIPE_PRICE_TRUST=price_xxxx
#      supabase secrets set RESEND_API_KEY=re_xxxx
#      supabase secrets set EMAIL_FROM="My AI Will <hello@myaiwill.com>"
#      supabase secrets set APP_ORIGIN=https://myaiwill.com
#
#    Or Dashboard → Project Settings → Edge Functions → Secrets
#
#    Then deploy:
#      supabase functions deploy checkout
#      supabase functions deploy stripe-webhook
#      supabase functions deploy questionnaire
#
#    Auto-provided by Supabase (do not set yourself):
#      SUPABASE_URL
#      SUPABASE_SERVICE_ROLE_KEY
#      SUPABASE_ANON_KEY
#
#    For local `supabase functions serve`, you can also put these in .env.local
#    (or supabase/.env) — they are read by Deno, not by Vite.
# -----------------------------------------------------------------------------

# Stripe secret key — NEVER expose to the browser / never use VITE_ prefix
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Stripe webhook signing secret — Dashboard → Developers → Webhooks → endpoint → Signing secret
# Endpoint URL:
#   https://YOUR_PROJECT_REF.supabase.co/functions/v1/stripe-webhook
# Listen for: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe Price IDs — Dashboard → Products → each price → copy "Price ID" (price_…)
# Individual $249 · Couples $399 · Trust add-on $50
# Put these on Supabase secrets (not Vercel). Checkout reads the live unit_amount from Stripe.
STRIPE_PRICE_INDIVIDUAL=price_your_individual_price_id
STRIPE_PRICE_COUPLES=price_your_couples_price_id
STRIPE_PRICE_TRUST=price_your_trust_price_id

# Resend API key — https://resend.com/api-keys  (REQUIRED for email)
RESEND_API_KEY=re_your_resend_api_key

# From address — real inbox on your Resend-verified domain (avoid noreply@)
# Examples:
#   My AI Will <hello@myaiwill.com>
#   My AI Will <scott@myaiwill.com>
EMAIL_FROM=My AI Will <hello@myaiwill.com>

# Public site URL — used in questionnaire invite + admin email links
APP_ORIGIN=https://myaiwill.com

# Optional alias for APP_ORIGIN (either works)
# PUBLIC_SITE_URL=https://myaiwill.com

# -----------------------------------------------------------------------------
# Who receives email (no secrets needed for these):
#   After Stripe payment → order.user_email (+ partner_email for couples)
#     with a private /questionnaire?token=… link (valid 30 days)
#   After questionnaire submit → client confirmation + admin_users alert
# -----------------------------------------------------------------------------
